---
import Base from "./Base.astro";
import { legalPages } from "../data/legal";

interface Props {
  title: string;
  description: string;
  updated: string;
  /** Slug of the current page, so it can be marked in the sidebar */
  current: string;
}
const { title, description, updated, current } = Astro.props;
---

<Base title={title} description={description}>
  <section class="legal-head">
    <div class="shell">
      <nav class="crumbs" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span aria-hidden="true">/</span>
        <span>Legal</span>
      </nav>
      <h1>{title}</h1>
      <p class="updated tnum">Last updated {updated}</p>
    </div>
  </section>

  <div class="shell legal-body">
    <nav class="side" aria-label="Legal pages">
      <h2>Legal</h2>
      <ul>
        {legalPages.map((p) => (
          <li>
            <a href={p.href} aria-current={p.slug === current ? "page" : undefined}>
              {p.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="legal-prose">
      <slot />
    </div>
  </div>
</Base>

<style>
  .legal-head { padding-block: 30px 0; }
  .crumbs {
    display: flex; gap: 10px; font-size: 15px;
    color: var(--pearl-faint); margin-bottom: 20px;
  }
  .crumbs a { color: var(--pearl-dim); text-decoration: none; }
  .crumbs a:hover { color: var(--gold-lit); }
  .legal-head h1 { font-size: clamp(31px, 4.4vw, 46px); }
  .updated { color: var(--pearl-faint); font-size: 14.5px; margin-top: 12px; }

  .legal-body {
    display: grid;
    grid-template-columns: 210px 1fr;
    gap: clamp(30px, 5vw, 62px);
    align-items: start;
    padding-block: 40px 80px;
  }

  .side { position: sticky; top: 96px; }
  .side h2 {
    font-family: var(--f-body);
    font-size: 12px; font-weight: 700; letter-spacing: .12em;
    text-transform: uppercase; color: var(--pearl-faint);
    margin-bottom: 12px;
  }
  .side ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 2px; }
  .side a {
    display: block; padding: 8px 0;
    font-size: 15.5px; color: var(--pearl-dim); text-decoration: none;
    border-left: 2px solid transparent; padding-left: 12px;
  }
  .side a:hover { color: var(--pearl); }
  .side a[aria-current="page"] {
    color: var(--gold-lit);
    border-left-color: var(--gold);
  }

  .legal-prose { max-width: 70ch; }
  .legal-prose :global(h2) {
    font-size: clamp(22px, 2.6vw, 28px);
    margin: 40px 0 12px;
  }
  .legal-prose :global(h2:first-child) { margin-top: 0; }
  .legal-prose :global(h3) { font-size: 19px; margin: 26px 0 8px; }
  .legal-prose :global(p) {
    margin-bottom: 16px; font-size: 16.5px; line-height: 1.68;
    color: #d6cfc6; max-width: none;
  }
  .legal-prose :global(strong) { color: var(--pearl); font-weight: 700; }
  .legal-prose :global(a) { color: var(--gold-lit); }
  .legal-prose :global(ul) { margin: 0 0 20px; padding-left: 0; list-style: none; }
  .legal-prose :global(li) {
    position: relative; padding-left: 22px; margin-bottom: 9px;
    font-size: 16.5px; line-height: 1.6; color: #d6cfc6;
  }
  .legal-prose :global(li)::before {
    content: ""; position: absolute; left: 0; top: 12px;
    width: 12px; height: 1px; background: var(--gold);
  }
  .legal-prose :global(.callout) {
    border-left: 3px solid var(--gold);
    background: var(--night-raised);
    padding: 18px 22px;
    margin: 24px 0;
    border-radius: 0 var(--r-md) var(--r-md) 0;
  }
  .legal-prose :global(.callout p:last-child) { margin-bottom: 0; }
  .legal-prose :global(.urgent) {
    border-left-color: var(--live);
    background: #e4574f14;
  }
  .legal-prose :global(table) {
    width: 100%; border-collapse: collapse; margin-bottom: 22px; font-size: 15.5px;
  }
  .legal-prose :global(th) {
    text-align: left; font-family: var(--f-body); font-size: 12px;
    font-weight: 700; letter-spacing: .1em; text-transform: uppercase;
    color: var(--pearl-faint); padding: 0 14px 8px 0;
    border-bottom: 1px solid var(--rule, #35293f);
  }
  .legal-prose :global(td) {
    padding: 12px 14px 12px 0; vertical-align: top;
    border-bottom: 1px solid #2b2136; color: #d6cfc6; line-height: 1.5;
  }

  @media (max-width: 820px) {
    .legal-body { grid-template-columns: 1fr; }
    .side { position: static; }
    .side ul { display: flex; flex-wrap: wrap; gap: 6px 4px; }
    .side a { border-left: none; padding: 7px 12px; border: 1px solid #35293f; border-radius: var(--r-sm); }
    .side a[aria-current="page"] { border-color: var(--gold); }
  }
</style>
