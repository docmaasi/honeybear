---
import { shows, weekdayName, timeLabel } from "../data/site";
import { nextOccurrence, isLive, relative } from "../data/schedule";
import { links } from "../data/site";

// Rendered at build time in Eastern, then corrected to the reader's own
// timezone on load. The page is never blank and never wrong for long.
const now = new Date();
const upcoming = shows
  .map((s) => ({
    show: s,
    occ: nextOccurrence(s.weekday, s.hourET, s.minuteET, s.runtimeMin, now),
  }))
  .sort((a, b) => a.occ.start.getTime() - b.occ.start.getTime());

const next = upcoming[0];
const live = isLive(next.occ, now);
---

<div class="next" data-next-show>
  <div class="next-head">
    <span class="badge" data-live-badge hidden>
      <span class="live-dot"></span>On air now
    </span>
    <span class="badge badge-quiet" data-next-badge>
      Next {relative(next.occ.start, now)}
    </span>
  </div>

  <h2 class="next-name">{next.show.name}</h2>

  <p class="next-when tnum" data-when>
    {weekdayName(next.show.weekday)}s at{" "}
    {timeLabel(next.show.hourET, next.show.minuteET)} Eastern
  </p>
  <p class="next-yours small tnum" data-yours hidden></p>

  <p class="next-blurb">{next.show.blurb}</p>

  <div class="next-actions">
    <a class="btn btn-gold" href={links.youtube} rel="noopener">
      {live ? "Join the stream" : "Watch on YouTube"}
    </a>
    <a class="btn btn-quiet" href="/shows">Full schedule</a>
  </div>
</div>

<script
  define:vars={{
    shows: shows.map((s) => ({
      name: s.name,
      weekday: s.weekday,
      hourET: s.hourET,
      minuteET: s.minuteET,
      runtimeMin: s.runtimeMin,
      blurb: s.blurb,
    })),
  }}
>
  // Re-run the same schedule maths in the reader's browser so the countdown
  // and the "your time" line are true wherever they are sitting.
  function etOffsetMinutes(at) {
    const dtf = new Intl.DateTimeFormat("en-US", {
      timeZone: "America/New_York", hour12: false,
      year: "numeric", month: "2-digit", day: "2-digit",
      hour: "2-digit", minute: "2-digit", second: "2-digit",
    });
    const p = {};
    for (const part of dtf.formatToParts(at)) p[part.type] = part.value;
    const asUTC = Date.UTC(+p.year, +p.month - 1, +p.day, +p.hour % 24, +p.minute, +p.second);
    return (asUTC - at.getTime()) / 60000;
  }
  function instantFromET(y, m, d, h, min) {
    const naive = Date.UTC(y, m - 1, d, h, min);
    let g = new Date(naive - etOffsetMinutes(new Date(naive)) * 60000);
    return new Date(naive - etOffsetMinutes(g) * 60000);
  }
  function etParts(at) {
    const dtf = new Intl.DateTimeFormat("en-US", {
      timeZone: "America/New_York", hour12: false,
      year: "numeric", month: "2-digit", day: "2-digit", weekday: "short",
    });
    const p = {};
    for (const part of dtf.formatToParts(at)) p[part.type] = part.value;
    const days = ["Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat"];
    return { year: +p.year, month: +p.month, day: +p.day, weekday: days.indexOf(p.weekday) };
  }
  function nextOcc(s, now) {
    const t = etParts(now);
    for (let add = 0; add <= 7; add++) {
      if ((t.weekday + add) % 7 !== s.weekday) continue;
      const start = instantFromET(t.year, t.month, t.day + add, s.hourET, s.minuteET);
      const end = new Date(start.getTime() + s.runtimeMin * 60000);
      if (end > now) return { start, end };
    }
    const start = instantFromET(t.year, t.month, t.day + 7, s.hourET, s.minuteET);
    return { start, end: new Date(start.getTime() + s.runtimeMin * 60000) };
  }
  function rel(d, now) {
    const ms = d - now;
    if (ms <= 0) return "now";
    const mins = Math.round(ms / 60000);
    if (mins < 60) return `in ${mins} minute${mins === 1 ? "" : "s"}`;
    const hours = Math.round(mins / 60);
    if (hours < 24) return `in ${hours} hour${hours === 1 ? "" : "s"}`;
    const days = Math.round(hours / 24);
    return `in ${days} day${days === 1 ? "" : "s"}`;
  }

  function render() {
    const root = document.querySelector("[data-next-show]");
    if (!root) return;
    const now = new Date();
    const sorted = shows
      .map((s) => ({ s, occ: nextOcc(s, now) }))
      .sort((a, b) => a.occ.start - b.occ.start);
    const { s, occ } = sorted[0];
    const live = now >= occ.start && now <= occ.end;

    root.querySelector(".next-name").textContent = s.name;
    root.querySelector(".next-blurb").textContent = s.blurb;

    const liveBadge = root.querySelector("[data-live-badge]");
    const nextBadge = root.querySelector("[data-next-badge]");
    liveBadge.hidden = !live;
    nextBadge.hidden = live;
    nextBadge.textContent = "Next " + rel(occ.start, now);

    // The reader's own timezone, named.
    const zone = new Intl.DateTimeFormat("en-US", { timeZoneName: "short" })
      .formatToParts(occ.start)
      .find((p) => p.type === "timeZoneName")?.value;
    const local = new Intl.DateTimeFormat("en-US", {
      weekday: "long", hour: "numeric", minute: "2-digit",
    }).format(occ.start);

    const yours = root.querySelector("[data-yours]");
    yours.textContent = `That is ${local} ${zone} where you are.`;
    yours.hidden = false;
  }

  render();
  setInterval(render, 60000);
</script>

<style>
  .next {
    display: flex;
    flex-direction: column;
    gap: 14px;
    align-items: flex-start;
  }
  .next-head { display: flex; gap: 10px; flex-wrap: wrap; }
  .badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 14px;
    font-weight: 700;
    padding: 6px 13px;
    border-radius: 999px;
    background: var(--live-soft);
    color: #f4b8b3;
    border: 1px solid var(--live-line);
  }
  .badge-quiet {
    background: transparent;
    color: var(--gold-line);
    border-color: #6b563a;
  }
  .next-name {
    font-size: clamp(25px, 3.2vw, 34px);
    line-height: 1.14;
  }
  .next-when {
    font-size: clamp(18px, 2.2vw, 22px);
    color: var(--on-night);
    font-weight: 500;
  }
  .next-yours { color: var(--on-night-2); }
  .next-blurb { color: var(--on-night-2); max-width: 46ch; }
  .next-actions {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    margin-top: 10px;
  }
</style>
