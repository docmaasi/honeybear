---
import { nav, links } from "../data/site";
const path = Astro.url.pathname.replace(/\/$/, "") || "/";
---

<header class="site-head">
  <div class="shell head-inner">
    <a href="/" class="brand" aria-label="HoneyBear Katherine, home">
      <img src="/images/hbk777-medallion.png" alt="" width="46" height="46" />
      <span class="brand-name">HoneyBear Katherine</span>
    </a>

    <button class="menu-btn" aria-expanded="false" aria-controls="nav" id="menu-btn">
      <span class="bars" aria-hidden="true"></span>
      <span class="sr">Menu</span>
    </button>

    <nav id="nav" class="nav" aria-label="Main">
      <ul>
        {nav.map((item) => (
          <li>
            <a
              href={item.href}
              aria-current={path === item.href ? "page" : undefined}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
      <a class="btn btn-gold watch-cta" href={links.youtube} rel="noopener">
        Watch
      </a>
    </nav>
  </div>
</header>

<style>
  .site-head {
    position: sticky;
    top: 0;
    z-index: 50;
    background: #17101fe6;
    backdrop-filter: blur(12px);
    border-bottom: 1px solid #2b2136;
  }
  .head-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    min-height: 74px;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
    color: var(--pearl);
    flex: none;
  }
  .brand img {
    border-radius: 50%;
    border: 1px solid var(--gold);
  }
  .brand-name {
    font-family: var(--f-display);
    font-size: 19px;
    font-weight: 600;
    letter-spacing: -0.015em;
  }

  .nav { display: flex; align-items: center; gap: 30px; }
  .nav ul {
    display: flex;
    gap: 26px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .nav ul a {
    color: var(--pearl-dim);
    text-decoration: none;
    font-size: 16px;
    font-weight: 500;
    padding-block: 6px;
    border-bottom: 1px solid transparent;
    transition: color .15s ease, border-color .15s ease;
  }
  .nav ul a:hover { color: var(--pearl); }
  .nav ul a[aria-current="page"] {
    color: var(--pearl);
    border-bottom-color: var(--gold);
  }
  .watch-cta { padding: 9px 18px; font-size: 15px; }

  .menu-btn { display: none; }
  .sr {
    position: absolute; width: 1px; height: 1px;
    overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap;
  }

  @media (max-width: 900px) {
    .brand-name { display: none; }
    .nav ul { gap: 18px; }
    .nav ul a { font-size: 15px; }
  }

  @media (max-width: 760px) {
    .menu-btn {
      display: grid;
      place-items: center;
      width: 44px; height: 44px;
      background: transparent;
      border: 1px solid #4a3a58;
      border-radius: var(--r-sm);
      cursor: pointer;
    }
    .bars, .bars::before, .bars::after {
      content: "";
      display: block;
      width: 19px; height: 2px;
      background: var(--pearl);
      transition: transform .2s ease, opacity .2s ease;
    }
    .bars { position: relative; }
    .bars::before { position: absolute; top: -6px; }
    .bars::after { position: absolute; top: 6px; }
    .menu-btn[aria-expanded="true"] .bars { background: transparent; }
    .menu-btn[aria-expanded="true"] .bars::before { transform: translateY(6px) rotate(45deg); }
    .menu-btn[aria-expanded="true"] .bars::after { transform: translateY(-6px) rotate(-45deg); }

    .brand-name { display: block; font-size: 17px; }
    .nav {
      position: absolute;
      inset: 100% 0 auto 0;
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      background: var(--night-raised);
      border-bottom: 1px solid #2b2136;
      padding: 8px var(--gutter) 22px;
      display: none;
    }
    .nav[data-open="true"] { display: flex; }
    .nav ul { flex-direction: column; gap: 0; }
    .nav li { border-bottom: 1px solid #2b2136; }
    .nav ul a {
      display: block;
      padding: 15px 0;
      font-size: 17px;
      border-bottom: none;
    }
    .nav ul a[aria-current="page"] { color: var(--gold-lit); }
    .watch-cta {
      margin-top: 18px;
      justify-content: center;
      padding: 13px 24px;
      font-size: 16px;
    }
  }
</style>

<script>
  const btn = document.getElementById("menu-btn");
  const nav = document.getElementById("nav");
  btn?.addEventListener("click", () => {
    const open = btn.getAttribute("aria-expanded") === "true";
    btn.setAttribute("aria-expanded", String(!open));
    nav?.setAttribute("data-open", String(!open));
  });
</script>
