---
import Base from "../../layouts/Base.astro";
import { getCollection, render } from "astro:content";
import { categories } from "../../data/categories";
import { site, links } from "../../data/site";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  const sorted = posts.sort((a, b) => b.data.date.localeCompare(a.data.date));
  return sorted.map((post, i) => ({
    params: { slug: post.id },
    props: {
      post,
      related: sorted
        .filter((p) => p.id !== post.id && p.data.category === post.data.category)
        .slice(0, 3),
    },
  }));
}

const { post, related } = Astro.props;
const { Content } = await render(post);
const d = post.data;
const cat = categories[d.category];

function pretty(iso: string) {
  const [y, m, day] = iso.split("-").map(Number);
  const months = ["January","February","March","April","May","June","July","August","September","October","November","December"];
  return `${months[m - 1]} ${day}, ${y}`;
}

const schema = [
  {
    "@type": "BlogPosting",
    "@id": `${site.domain}/blog/${post.id}`,
    headline: d.title,
    description: d.description,
    datePublished: d.date,
    dateModified: d.date,
    image: new URL(d.image, site.domain).href,
    author: { "@id": `${site.domain}/#katherine` },
    publisher: { "@id": `${site.domain}/#katherine` },
    inLanguage: "en-US",
    articleSection: cat.name,
    isPartOf: { "@id": `${site.domain}/blog` },
    mainEntityOfPage: `${site.domain}/blog/${post.id}`,
  },
  {
    "@type": "FAQPage",
    mainEntity: [
      {
        "@type": "Question",
        name: d.answers,
        acceptedAnswer: { "@type": "Answer", text: d.quickAnswer },
      },
    ],
  },
  {
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: site.domain },
      { "@type": "ListItem", position: 2, name: "Journal", item: `${site.domain}/blog` },
      { "@type": "ListItem", position: 3, name: d.title },
    ],
  },
];
---

<Base
  title={d.title}
  description={d.description}
  image={d.image}
  schema={schema}
  appendSite={false}
>
  <article>
    <header class="post-head">
      <div class="shell">
        <nav class="crumbs" aria-label="Breadcrumb">
          <a href="/">Home</a>
          <span aria-hidden="true">/</span>
          <a href="/blog">Journal</a>
        </nav>
        <p class="cat">{cat.name}</p>
        <h1>{d.title}</h1>
        <p class="date tnum">{pretty(d.date)}</p>
      </div>
    </header>

    <div class="shell hero-img">
      <img src={d.image} alt="" width="1000" height="625" />
    </div>

    <div class="shell">
      <!-- The direct answer, first thing on the page. -->
      <div class="answer">
        <h2>{d.answers}</h2>
        <p>{d.quickAnswer}</p>
      </div>

      <div class="prose">
        <Content />
      </div>

      {d.book && (
        <aside class="book-note">
          <h3>Weight Of Dysfunction</h3>
          <p>
            Katherine's book is a journal account of a woman in an abusive
            marriage, kept from 1981 to 1992. She published it so that a reader
            might recognise their own situation in it.
          </p>
          <a class="btn btn-gold" href={links.book} rel="noopener">
            Find it on Amazon
          </a>
        </aside>
      )}

      <aside class="show-note">
        <p>
          <strong>HoneyBear Katherine's Haven</strong> is a live relationship
          podcast recorded in <strong>Meta Horizon Worlds</strong> and{" "}
          <strong>Clubroom</strong>, with an audience that joins the
          conversation.
        </p>
        <div class="show-actions">
          <a class="btn btn-quiet" href="/shows">When it airs</a>
          <a class="btn btn-quiet" href={links.youtube} rel="noopener">Watch</a>
        </div>
      </aside>
    </div>

    {related.length > 0 && (
      <section class="related">
        <div class="shell">
          <div class="rule"><h2>More on this</h2></div>
          <div class="rel-grid">
            {related.map((p) => (
              <a class="card" href={`/blog/${p.id}`}>
                <div class="card-img">
                  <img src={p.data.image} alt="" loading="lazy" width="1000" height="625" />
                </div>
                <h3>{p.data.title}</h3>
              </a>
            ))}
          </div>
        </div>
      </section>
    )}
  </article>
</Base>

<style>
  .post-head { padding-block: 28px 22px; }
  .post-head .shell { max-width: 800px; }
  .crumbs {
    display: flex; gap: 10px; font-size: 15px;
    color: var(--muted); margin-bottom: 22px;
  }
  .crumbs a { color: var(--ink-2); text-decoration: none; }
  .crumbs a:hover { color: var(--gold); }
  .cat { color: var(--gold); font-size: 15px; font-weight: 600; margin-bottom: 10px; }
  .post-head h1 { font-size: clamp(31px, 4.6vw, 50px); margin-bottom: 12px; }
  .date { color: var(--muted); font-size: 14.5px; }

  .hero-img { max-width: 900px; }
  .hero-img img {
    width: 100%;
    border-radius: var(--r-md);
    border: 1px solid var(--rule);
    display: block;
  }

  .answer {
    max-width: 800px;
    margin: 34px auto 0;
    background: var(--paper-raised);
    border-left: 3px solid var(--gold);
    border-radius: 0 var(--r-md) var(--r-md) 0;
    padding: 22px 26px;
  }
  .answer h2 {
    font-size: 19px;
    margin-bottom: 8px;
    font-family: var(--f-body);
    font-weight: 700;
    letter-spacing: 0;
  }
  .answer p { font-size: 17px; line-height: 1.6; color: var(--ink); max-width: none; }

  .prose { max-width: 720px; margin: 0 auto; padding-block: 8px 20px; }
  .prose :global(h2) {
    font-size: clamp(23px, 2.8vw, 30px);
    margin: 42px 0 14px;
  }
  .prose :global(h3) { font-size: 21px; margin: 30px 0 10px; }
  .prose :global(p) {
    margin-bottom: 18px;
    font-size: 17.5px;
    line-height: 1.72;
    color: var(--ink-2);
    max-width: none;
  }
  .prose :global(strong) { color: var(--ink); font-weight: 700; }
  .prose :global(ul) { margin: 0 0 20px; padding-left: 0; list-style: none; }
  .prose :global(li) {
    position: relative;
    padding-left: 24px;
    margin-bottom: 11px;
    font-size: 17px;
    line-height: 1.62;
    color: var(--ink-2);
  }
  .prose :global(li)::before {
    content: "";
    position: absolute;
    left: 0; top: 13px;
    width: 13px; height: 1px;
    background: var(--gold);
  }
  .prose :global(blockquote) {
    margin: 26px 0;
    padding: 4px 0 4px 22px;
    border-left: 2px solid var(--gold);
  }
  .prose :global(blockquote p) {
    font-family: var(--f-display);
    font-size: 21px;
    font-style: italic;
    line-height: 1.45;
    color: var(--ink);
    margin: 0;
  }

  .book-note, .show-note {
    max-width: 720px;
    margin: 34px auto 0;
    padding: 24px 26px;
    border-radius: var(--r-md);
  }
  .book-note {
    background: var(--paper-raised);
    border: 1px solid var(--gold);
    display: flex; flex-direction: column; gap: 12px;
  }
  .book-note h3 { font-size: 22px; }
  .book-note p { color: var(--ink-2); font-size: 16px; }
  .book-note .btn { align-self: flex-start; }

  .show-note {
    background: var(--paper-sunk);
    border: 1px solid var(--rule);
    display: flex; flex-direction: column; gap: 14px;
  }
  .show-note p { font-size: 16.5px; color: var(--ink-2); max-width: none; }
  .show-actions { display: flex; gap: 10px; flex-wrap: wrap; }

  .related { padding-block: clamp(40px, 6vw, 70px) 0; }
  .rel-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 28px 26px;
  }
  .card { display: flex; flex-direction: column; gap: 11px; text-decoration: none; color: inherit; }
  .card-img {
    border-radius: var(--r-md); overflow: hidden;
    border: 1px solid var(--rule); aspect-ratio: 16 / 10;
  }
  .card-img img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .card:hover .card-img { border-color: var(--gold); }
  .card:hover h3 { color: var(--gold); }
  .card h3 { font-size: 18px; line-height: 1.22; }
</style>
