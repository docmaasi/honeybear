---
import Base from "../../layouts/Base.astro";
import EpisodeCard from "../../components/EpisodeCard.astro";
import LiteYouTube from "../../components/LiteYouTube.astro";
import {
  episodes, formatDate, isDateOnlyTitle, watchUrl, thumbUrl, remoteThumbUrl,
} from "../../data/episodes";
import { site, links } from "../../data/site";

export function getStaticPaths() {
  return episodes.map((ep, i) => ({
    params: { id: ep.id },
    props: { episode: ep, index: i },
  }));
}

const { episode, index } = Astro.props;

const untitled = isDateOnlyTitle(episode.title);
const heading = untitled ? formatDate(episode.published) : episode.title;
const description =
  episode.summary ??
  `HoneyBear Katherine's Haven, published ${formatDate(episode.published)}. Encouragement, resilience, and everyday hope with Katherine L. Carter.`;

const more = episodes.filter((e) => e.id !== episode.id).slice(0, 3);

const schema = [
  {
    "@type": "PodcastEpisode",
    "@id": `${site.domain}/episodes/${episode.id}`,
    name: heading,
    description,
    datePublished: episode.published,
    url: `${site.domain}/episodes/${episode.id}`,
    partOfSeries: { "@id": `${site.domain}/#haven` },
    author: { "@id": `${site.domain}/#katherine` },
    associatedMedia: {
      "@type": "VideoObject",
      name: heading,
      description,
      uploadDate: episode.published,
      thumbnailUrl: remoteThumbUrl(episode.id),
      embedUrl: `https://www.youtube.com/embed/${episode.id}`,
      contentUrl: watchUrl(episode.id),
    },
  },
  {
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: site.domain },
      { "@type": "ListItem", position: 2, name: "Episodes", item: `${site.domain}/episodes` },
      { "@type": "ListItem", position: 3, name: heading },
    ],
  },
];
---

<Base
  title={heading}
  description={description}
  image={thumbUrl(episode.id)}
  schema={schema}
>
  <section class="ep-head">
    <div class="shell">
      <nav class="crumbs" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span aria-hidden="true">/</span>
        <a href="/episodes">Episodes</a>
      </nav>

      <div class="player">
        <LiteYouTube id={episode.id} title={heading} poster={thumbUrl(episode.id)} />
      </div>

      <div class="ep-meta stack stack-sm">
        <h1>{heading}</h1>
        <p class="small tnum">Published {formatDate(episode.published)}</p>
        {episode.summary && <p class="lede sum">{episode.summary}</p>}
        <p class="actions">
          <a class="btn btn-quiet" href={watchUrl(episode.id)} rel="noopener">
            Open on YouTube
          </a>
          <a class="btn btn-quiet" href={links.youtube} rel="noopener">
            Subscribe
          </a>
        </p>
      </div>
    </div>
  </section>

  <section class="more">
    <div class="shell">
      <div class="rule"><h2>More episodes</h2></div>
      <div class="ep-grid">
        {more.map((ep) => <EpisodeCard episode={ep} />)}
      </div>
    </div>
  </section>
</Base>

<style>
  .ep-head { padding-block: 30px clamp(30px, 5vw, 56px); }
  .crumbs {
    display: flex;
    gap: 10px;
    font-size: 15px;
    color: var(--pearl-faint);
    margin-bottom: 24px;
  }
  .crumbs a { color: var(--pearl-dim); text-decoration: none; }
  .crumbs a:hover { color: var(--gold-lit); }

  .player { box-shadow: 0 30px 70px -30px #000; border-radius: var(--r-md); }

  .ep-meta { margin-top: 30px; max-width: 66ch; }
  .sum { color: var(--pearl-dim); }
  .actions { display: flex; gap: 12px; flex-wrap: wrap; margin-top: 10px; }

  .ep-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 34px 30px;
  }
</style>
