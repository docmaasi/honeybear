---
import Base from "../layouts/Base.astro";
import { site, links } from "../data/site";

// The form posts to Web3Forms, which emails Katherine directly and needs no
// server. It only renders when a key is configured — a form that cannot
// deliver is worse than no form, so we never show a dead one.
const formKey = import.meta.env.PUBLIC_CONTACT_FORM_KEY ?? "";
const hasForm = formKey.length > 0;

const schema = [
  {
    "@type": "ContactPage",
    name: "Contact HoneyBear Katherine",
    url: `${site.domain}/contact`,
    mainEntity: { "@id": `${site.domain}/#katherine` },
  },
];
---

<Base
  title="Contact"
  description="Get in touch with Katherine L. Carter about guesting on the Haven, sponsorship, speaking, or anything else."
  schema={schema}
>
  <section class="head">
    <div class="shell stack stack-md">
      <h1>Get in touch</h1>
      <p class="lede">
        Coming on as a guest, working together, or just saying hello — all of it
        is welcome.
      </p>
    </div>
  </section>

  <section class="body">
    <div class="shell contact-grid">
      <div class="ways stack stack-lg">
        <div class="way">
          <h2>Email</h2>
          <p class="big">
            <a href={`mailto:${links.email}`}>{links.email}</a>
          </p>
          <p class="small">Usually the fastest way to reach her.</p>
        </div>

        <div class="way">
          <h2>Message her directly</h2>
          <ul class="dm">
            <li><a href={links.facebook} rel="noopener">Facebook</a></li>
            <li><a href={links.instagram} rel="noopener">Instagram</a></li>
            <li><a href={links.youtube} rel="noopener">YouTube</a></li>
          </ul>
          <p class="small">
            Katherine reads her own messages on all three.
          </p>
        </div>

        <div class="way">
          <h2>Come to a show</h2>
          <p>
            The simplest introduction is to turn up. The Haven runs Fridays and
            the audience talks throughout.
          </p>
          <p><a class="btn btn-quiet" href="/shows">See the schedule</a></p>
        </div>
      </div>

      {hasForm && (
        <div class="form-wrap panel">
          <h2>Send a message</h2>
          <form action="https://api.web3forms.com/submit" method="POST" class="form">
            <input type="hidden" name="access_key" value={formKey} />
            <input type="hidden" name="subject" value="New message from honeybearkatherine.org" />
            <input type="checkbox" name="botcheck" class="hp" tabindex="-1" autocomplete="off" />

            <label>
              <span>Your name</span>
              <input type="text" name="name" required autocomplete="name" />
            </label>
            <label>
              <span>Email</span>
              <input type="email" name="email" required autocomplete="email" />
            </label>
            <label>
              <span>What is this about?</span>
              <select name="topic">
                <option>Coming on as a guest</option>
                <option>Sponsorship or partnership</option>
                <option>Speaking or an event</option>
                <option>Something else</option>
              </select>
            </label>
            <label>
              <span>Message</span>
              <textarea name="message" rows="6" required></textarea>
            </label>
            <button class="btn btn-gold" type="submit">Send message</button>
          </form>
        </div>
      )}
    </div>
  </section>
</Base>

<style>
  .head { padding-block: clamp(46px, 7vw, 82px) 0; }
  .body { padding-top: clamp(34px, 5vw, 54px); }
  .contact-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(34px, 5vw, 66px);
    align-items: start;
  }
  .contact-grid:has(> :only-child) { grid-template-columns: 1fr; max-width: 680px; }

  .way h2 { font-size: 22px; margin-bottom: 8px; }
  .way p { color: var(--pearl-dim); }
  .big {
    font-family: var(--f-display);
    font-size: clamp(21px, 2.6vw, 27px);
    word-break: break-word;
  }
  .big a { text-decoration: none; }
  .dm { list-style: none; padding: 0; margin: 4px 0 8px; display: flex; gap: 20px; flex-wrap: wrap; }

  .form { display: flex; flex-direction: column; gap: 16px; margin-top: 18px; }
  .form label { display: flex; flex-direction: column; gap: 6px; }
  .form span { font-size: 15px; font-weight: 500; }
  .form input[type="text"],
  .form input[type="email"],
  .form select,
  .form textarea {
    font-family: var(--f-body);
    font-size: 16px;
    color: var(--pearl);
    background: var(--night-sunk);
    border: 1px solid #3c2f47;
    border-radius: var(--r-sm);
    padding: 12px 14px;
    width: 100%;
  }
  .form textarea { resize: vertical; }
  .form :is(input, select, textarea):focus-visible { border-color: var(--gold); }
  .form button { align-self: flex-start; margin-top: 4px; }
  .hp { position: absolute; left: -9999px; }

  @media (max-width: 820px) {
    .contact-grid { grid-template-columns: 1fr; }
  }
</style>
