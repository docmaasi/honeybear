---
import Base from "../layouts/Base.astro";
import NextShow from "../components/NextShow.astro";
import EpisodeCard from "../components/EpisodeCard.astro";
import { site, links, worlds, bingo, weekdayName, timeLabel } from "../data/site";
import { episodes } from "../data/episodes";
import { topics } from "../data/topics";

const recent = episodes.slice(0, 6);

const schema = [
  {
    "@type": "PodcastSeries",
    "@id": `${site.domain}/#haven`,
    name: "HoneyBear Katherine's Haven",
    description:
      "A weekly podcast about encouragement, resilience, and everyday hope, recorded live in Meta Horizon Worlds with a listening audience that joins the conversation.",
    url: `${site.domain}/shows`,
    webFeed: `https://www.youtube.com/feeds/videos.xml?channel_id=${links.youtubeChannelId}`,
    author: { "@id": `${site.domain}/#katherine` },
    inLanguage: "en-US",
  },
];
---

<Base
  title="HoneyBear Katherine — encouragement, every week"
  description={site.description}
  schema={schema}
>
  <!-- Hero: what is on, and when. The question the old site never answered. -->
  <section class="hero band-dark">
    <div class="hero-bg" aria-hidden="true"></div>
    <div class="shell hero-grid">
      <div class="hero-copy">
        <p class="kicker">Live in Meta Horizon Worlds and Clubroom</p>
        <h1>Encouragement, every&nbsp;week.</h1>
        <NextShow />
      </div>

      <div class="hero-portrait">
        <span class="lamp"></span>
        <div class="medallion">
          <img
            src="/art/katherine-portrait.jpg"
            alt="Katherine L. Carter, host of HoneyBear Katherine's Haven"
            width="520"
            height="520"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- What the show is about -->
  <section class="topics-sec band-plum wash">
    <div class="shell">
      <div class="rule"><h2>A relationship podcast</h2></div>
      <p class="lede intro">
        Recorded live in virtual reality, with an audience in the room. These
        are the subjects the Haven keeps returning to.
      </p>
      <div class="topic-grid">
        {topics.map((t) => (
          <a class="tcard" href={`/topics#${t.slug}`}>
            <div class="tcard-img">
              <img src={t.image} alt="" loading="lazy" width="800" height="600" />
            </div>
            <h3>{t.name}</h3>
            <p>{t.blurb}</p>
          </a>
        ))}
      </div>
      <p class="more">
        <a class="btn btn-quiet" href="/topics">What the show is about</a>
      </p>
    </div>
  </section>

  <!-- Recent episodes -->
  <section class="band-tint">
    <div class="shell">
      <div class="rule"><h2>Recent episodes</h2></div>
      <div class="ep-grid">
        {recent.map((ep) => <EpisodeCard episode={ep} />)}
      </div>
      <p class="more">
        <a class="btn btn-quiet" href="/episodes">See all {episodes.length} episodes</a>
      </p>
    </div>
  </section>

  <!-- Worlds -->
  <section class="worlds band-gold">
    <div class="shell">
      <div class="rule"><h2>Places she built</h2></div>
      <p class="lede intro">
        Katherine designs and runs her own worlds inside Meta Horizon. They are
        open, they are free, and people actually live in them.
      </p>
      <div class="world-grid">
        {worlds.map((w) => (
          <article class="world">
            <h3>{w.name}</h3>
            <p class="small where">{w.where}</p>
            <p>{w.blurb}</p>
          </article>
        ))}
        <article class="world world-bingo">
          <h3>{bingo.name}</h3>
          <p class="small where tnum">
            {bingo.slots
              .map((s) => `${weekdayName(s.weekday)} ${timeLabel(s.hourET, s.minuteET)}`)
              .join(" · ")} Eastern
          </p>
          <p>{bingo.blurb}</p>
        </article>
      </div>
      <p class="more">
        <a class="btn btn-quiet" href="/worlds">More about the worlds</a>
      </p>
    </div>
  </section>

  <!-- Book -->
  <section class="book band-dark">
    <div class="shell book-grid">
      <div class="stack stack-md">
        <div class="rule"><h2>Weight Of Dysfunction</h2></div>
        <p class="lede">
          Katherine's book: a woman's journal from inside an abusive marriage,
          kept from 1981 to 1992 and published so someone else might recognise
          their own situation in it.
        </p>
        <div class="next-actions">
          <a class="btn btn-gold" href="/book">About the book</a>
          <a class="btn btn-quiet" href={links.book} rel="noopener">
            Buy on Amazon
          </a>
        </div>
      </div>
      <div class="book-cover">
        <img
          src="/art/weight-of-dysfunction-cover.jpg"
          alt="Cover of Weight Of Dysfunction by Katherine L. Carter"
          width="667"
          height="1000"
          loading="lazy"
        />
      </div>
    </div>
  </section>
</Base>

<style>
  .hero {
    padding-block: clamp(52px, 7vw, 88px) clamp(46px, 6vw, 74px);
    position: relative;
    overflow: hidden;
  }
  /* The Haven room itself, dimmed hard so it reads as atmosphere, not wallpaper. */
  .hero-bg {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(105deg, #1b1424f2 0%, #1b1424d9 42%, #1b1424a6 100%),
      url("/art/haven-room.jpg");
    background-size: cover, cover;
    background-position: center, center 32%;
    pointer-events: none;
  }
  /* a warm edge where the band meets the pearl below */
  .hero::after {
    content: "";
    position: absolute;
    left: 0; right: 0; bottom: 0;
    height: 3px;
    background: linear-gradient(to right, var(--gold-line), #6b2fa0 55%, transparent);
  }
  .hero-grid {
    position: relative;
    display: grid;
    grid-template-columns: 1.25fr 0.75fr;
    gap: clamp(34px, 6vw, 76px);
    align-items: center;
  }
  .kicker {
    font-size: 15px;
    color: var(--gold-line);
    letter-spacing: 0.02em;
    margin-bottom: 14px;
  }
  .hero-copy h1 {
    font-size: clamp(36px, 5.6vw, 60px);
    margin-bottom: 30px;
    max-width: 15ch;
  }
  .hero-portrait { position: relative; max-width: 380px; justify-self: end; width: 100%; }


  .topic-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
    gap: 30px 26px;
  }
  .tcard {
    display: flex;
    flex-direction: column;
    gap: 11px;
    text-decoration: none;
    color: inherit;
  }
  .tcard-img {
    border-radius: var(--r-md);
    overflow: hidden;
    border: 1px solid #ffffffb3;
    aspect-ratio: 4 / 3;
    box-shadow: var(--shadow-card);
  }
  .tcard-img img {
    width: 100%; height: 100%; object-fit: cover; display: block;
    transition: transform .4s ease;
  }
  .tcard:hover .tcard-img img { transform: scale(1.04); }
  .tcard:hover .tcard-img { border-color: var(--gold); }
  .tcard:hover h3 { color: var(--accent); }
  .tcard h3 { font-size: 20px; }
  .tcard p { font-size: 15.5px; color: var(--ink-2); line-height: 1.5; }

  .ep-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 40px 32px;
  }
  .more { margin-top: 44px; }


  .intro { margin-bottom: 38px; max-width: 58ch; }
  .world-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 34px;
  }
  .world {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding-top: 22px;
    border-top: 2px solid var(--accent-line);
  }
  .world-bingo { border-top-color: var(--gold); }
  .world .where { color: var(--muted); }
  .world p { font-size: 16px; color: var(--ink-2); }

  .book-grid {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: clamp(30px, 5vw, 60px);
    align-items: center;
  }
  .book-cover { justify-self: center; max-width: 260px; width: 100%; }
  .book-cover img {
    width: 100%;
    border-radius: 3px;
    transform: rotate(-1.6deg);
    box-shadow: 0 2px 0 0 #ffffff14, 0 30px 60px -22px #000;
  }
  .next-actions { display: flex; gap: 12px; flex-wrap: wrap; }

  @media (max-width: 880px) {
    .hero-grid { grid-template-columns: 1fr; }
    .hero-portrait { justify-self: start; max-width: 260px; order: -1; }
    .book-grid { grid-template-columns: 1fr; }
  }
</style>
