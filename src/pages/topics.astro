---
import Base from "../layouts/Base.astro";
import { topics } from "../data/topics";
import { episodesByTopic, isDateOnlyTitle, formatDate } from "../data/episodes";
import { site } from "../data/site";

const withEpisodes = topics.map((t) => ({
  topic: t,
  eps: episodesByTopic(t.slug),
}));

// Every question here is answered on the page, so the markup is honest.
const schema = [
  {
    "@type": "CollectionPage",
    name: "Relationship topics on HoneyBear Katherine's Haven",
    description:
      "The relationship subjects the Haven works through: intimacy and attraction, friendship, family, conflict and repair, healing and self-worth, and safety.",
    url: `${site.domain}/topics`,
    about: topics.map((t) => ({ "@type": "Thing", name: t.name })),
  },
];
---

<Base
  title="What the show is about"
  description="The relationship subjects HoneyBear Katherine's Haven works through — intimacy, friendship, family patterns, conflict and repair, self-worth, and knowing when a relationship has stopped being safe."
  image="/art/topics/intimacy.jpg"
  schema={schema}
>
  <section class="head">
    <div class="shell stack stack-md">
      <h1>What the show is about</h1>
      <p class="lede">
        The Haven is a relationship podcast, recorded live in virtual reality
        with an audience in the room. These are the subjects it keeps coming
        back to — and the questions people actually arrive with.
      </p>
    </div>
  </section>

  <section class="topics">
    <div class="shell stack">
      {withEpisodes.map(({ topic, eps }) => (
        <article class="topic" id={topic.slug}>
          <div class="topic-img">
            <img src={topic.image} alt="" loading="lazy" width="800" height="600" />
          </div>

          <div class="topic-body">
            <h2>{topic.name}</h2>
            <p class="blurb">{topic.blurb}</p>
            <p class="body">{topic.body}</p>

            <ul class="qs">
              {topic.questions.map((q) => <li>{q}</li>)}
            </ul>

            {eps.length > 0 ? (
              <div class="eps">
                <h3>Episodes on this</h3>
                <ul class="ep-links">
                  {eps.map((e) => (
                    <li>
                      <a href={`/episodes/${e.id}`}>
                        {isDateOnlyTitle(e.title) ? formatDate(e.published) : e.title}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            ) : (
              <p class="none">
                <a href="/episodes">Browse every episode</a> — this subject runs
                throughout the archive.
              </p>
            )}

            {topic.slug === "safety-respect" && (
              <p class="hoh-link">
                <a class="btn btn-gold" href="/harbor-of-hope">
                  Harbor of Hope: help and hotlines
                </a>
              </p>
            )}
          </div>
        </article>
      ))}
    </div>
  </section>
</Base>

<style>
  .head { padding-block: clamp(46px, 7vw, 82px) 0; }
  .topics { padding-top: clamp(34px, 5vw, 56px); }
  .topics .stack { gap: clamp(48px, 7vw, 82px); }

  .topic {
    display: grid;
    grid-template-columns: 380px 1fr;
    gap: clamp(28px, 4vw, 52px);
    align-items: start;
  }
  /* alternate the image side so the page has a rhythm rather than a column */
  .topic:nth-child(even) .topic-img { order: 2; }

  .topic-img {
    border-radius: var(--r-md);
    overflow: hidden;
    border: 1px solid var(--rule);
    aspect-ratio: 4 / 3;
  }
  .topic-img img { width: 100%; height: 100%; object-fit: cover; display: block; }

  .topic-body { display: flex; flex-direction: column; gap: 14px; }
  .topic h2 { font-size: clamp(25px, 3.2vw, 33px); }
  .blurb {
    font-size: 18px;
    color: var(--gold);
    font-family: var(--f-display);
    font-style: italic;
    max-width: 44ch;
  }
  .body { color: var(--ink-2); max-width: 56ch; }

  .qs {
    list-style: none;
    margin: 6px 0 0;
    padding: 0;
    display: grid;
    gap: 9px;
    max-width: 54ch;
  }
  .qs li {
    position: relative;
    padding-left: 22px;
    font-size: 16.5px;
    line-height: 1.5;
  }
  .qs li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 12px;
    width: 12px;
    height: 1px;
    background: var(--gold);
  }

  .eps { margin-top: 8px; }
  .eps h3 { font-size: 17px; margin-bottom: 7px; }
  .ep-links { list-style: none; margin: 0; padding: 0; display: grid; gap: 5px; }
  .ep-links a { font-size: 16px; }
  .none { font-size: 15.5px; color: var(--ink-2); margin-top: 4px; }
  .hoh-link { margin-top: 8px; }

  @media (max-width: 860px) {
    .topic { grid-template-columns: 1fr; }
    .topic:nth-child(even) .topic-img { order: 0; }
    .topic-img { max-width: 480px; }
  }
</style>
