---
import Base from "../layouts/Base.astro";
import {
  site, links, shows, bingo, weekdayName, timeLabel, zoneLine, airingLine,
} from "../data/site";
import { nextOccurrence } from "../data/schedule";

const now = new Date();

// A show can run more than one night, so each airing gets its own Event in
// the structured data — otherwise search engines only ever learn about one.
const schema = shows.flatMap((s) =>
  s.airings.map((a) => {
    const next = nextOccurrence(a.weekday, a.hourET, a.minuteET, s.runtimeMin, now);
    return {
      "@type": "Event",
      name: s.name,
      description: s.blurb,
      startDate: next.start.toISOString(),
      endDate: next.end.toISOString(),
      eventStatus: "https://schema.org/EventScheduled",
      eventAttendanceMode: "https://schema.org/OnlineEventAttendanceMode",
      location: { "@type": "VirtualLocation", name: a.venue, url: links.youtube },
      performer: { "@id": `${site.domain}/#katherine` },
      organizer: { "@id": `${site.domain}/#katherine` },
    };
  }),
);
---

<Base
  title="Shows and schedule"
  description="When HoneyBear Katherine's Haven, Word of Blessing, and Bingo Under the Stars air each week — in every US time zone."
  schema={schema}
>
  <section class="head">
    <div class="shell stack stack-md">
      <h1>What's on, and when</h1>
      <p class="lede">
        Everything runs on Eastern time. The line under each show converts it
        for the rest of the country, so nobody has to do the arithmetic.
      </p>
    </div>
  </section>

  <section class="list">
    <div class="shell stack stack-lg">
      {shows.map((s) => (
        <article class={s.artW > s.artH ? "show show-banner" : "show"}>
          <div class="show-art">
            <img src={s.art} alt="" width={s.artW} height={s.artH} loading="lazy" />
          </div>
          <div class="stack stack-sm show-body">
            <h2>{s.name}</h2>
            {s.tagline && <p class="show-tagline">{s.tagline}</p>}
            <ul class="airings">
              {s.airings.map((a) => (
                <li>
                  <p class="when tnum">{airingLine(a)}</p>
                  <p class="zones small tnum">{zoneLine(a.hourET, a.minuteET)}</p>
                  <p class="venue small">{a.venue}</p>
                </li>
              ))}
            </ul>
            {s.firstBroadcast && (
              <p class="first-air small">First broadcast {s.firstBroadcast}.</p>
            )}
            <p class="blurb">{s.blurb}</p>
            <p class="cta">
              <a class="btn btn-gold" href={links.youtube} rel="noopener">
                Watch on YouTube
              </a>
            </p>
          </div>
        </article>
      ))}

      <article class="show show-alt">
        <div class="stack stack-sm show-body">
          <h2>{bingo.name}</h2>
          <ul class="slots">
            {bingo.slots.map((sl) => (
              <li class="tnum">
                <strong>{weekdayName(sl.weekday)}</strong>
                <span>{timeLabel(sl.hourET, sl.minuteET)} Eastern</span>
                <span class="small">{zoneLine(sl.hourET, sl.minuteET)}</span>
              </li>
            ))}
          </ul>
          <p class="blurb">{bingo.blurb}</p>
        </div>
      </article>
    </div>
  </section>
</Base>

<style>
  .head { padding-block: clamp(46px, 7vw, 82px) 10px; }
  .list { padding-top: clamp(34px, 5vw, 58px); }

  .show {
    display: grid;
    grid-template-columns: 200px 1fr;
    gap: 34px;
    align-items: start;
    padding-bottom: 46px;
    border-bottom: 1px solid var(--rule);
  }
  .show:last-child { border-bottom: none; }
  .show-alt { grid-template-columns: 1fr; }
  .show-art img {
    width: 100%;
    border-radius: var(--r-md);
    border: 1px solid var(--rule);
    display: block;
  }
  .show-banner { grid-template-columns: 1fr; }
  .show-banner .show-art { max-width: 620px; }

  .show-tagline {
    font-family: var(--font-display, inherit);
    font-style: italic;
    font-size: 19px;
    color: var(--plum, var(--ink-2));
  }

  .airings { list-style: none; padding: 0; margin: 4px 0 0; display: grid; gap: 14px; }
  .airings li { display: grid; gap: 1px; }
  .venue { color: var(--ink-2); }
  .first-air { color: var(--muted); font-style: italic; }

  .when {
    font-size: 19px;
    color: var(--gold);
    font-weight: 500;
  }
  .zones { color: var(--muted); }
  .blurb { color: var(--ink-2); margin-top: 6px; }
  .cta { margin-top: 12px; }

  .slots { list-style: none; padding: 0; margin: 6px 0 0; display: grid; gap: 12px; }
  .slots li {
    display: grid;
    grid-template-columns: 120px 190px 1fr;
    gap: 12px;
    align-items: baseline;
    padding-bottom: 12px;
    border-bottom: 1px solid var(--rule);
  }
  .slots .small { color: var(--muted); }

  @media (max-width: 720px) {
    .show { grid-template-columns: 1fr; gap: 22px; }
    .show-art { max-width: 180px; }
    .show-banner .show-art { max-width: 100%; }
    .slots li { grid-template-columns: 1fr; gap: 2px; }
  }
</style>
