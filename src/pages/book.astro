---
import Base from "../layouts/Base.astro";
import { site, links } from "../data/site";

const schema = [
  {
    "@type": "Book",
    name: "Weight of Dysfunction",
    author: { "@id": `${site.domain}/#katherine` },
    url: `${site.domain}/book`,
    sameAs: links.book,
    inLanguage: "en-US",
    bookFormat: "https://schema.org/Paperback",
    isbn: "1667889222",
  },
];
---

<Base
  title="Weight of Dysfunction"
  description="Weight of Dysfunction by Katherine L. Carter — on what families carry, what gets handed down, and how a person puts it down."
  schema={schema}
>
  <section class="head">
    <div class="shell book-grid">
      <div class="stack stack-md">
        <h1>Weight of Dysfunction</h1>
        <p class="byline">by Katherine L. Carter</p>
        <p class="lede">
          On what families carry, what quietly gets handed from one generation
          to the next, and what it takes for a person to set it down.
        </p>
        <div class="actions">
          <a class="btn btn-gold" href={links.book} rel="noopener">
            Buy on Amazon
          </a>
          <a class="btn btn-quiet" href="/about">About Katherine</a>
        </div>
      </div>

      <aside class="cover panel">
        <p class="pull">
          The same themes run through the podcast: resilience, relationships,
          and the work of growing past what shaped you.
        </p>
        <p class="small">
          The book and the show sit on the same ground, so readers and listeners
          tend to be looking for the same thing.
        </p>
      </aside>
    </div>
  </section>

  <section class="more">
    <div class="shell">
      <div class="rule"><h2>If the book resonates</h2></div>
      <div class="cards">
        <a class="card" href="/episodes">
          <h3>Listen to the Haven</h3>
          <p>Weekly conversations on the same subjects, with guests who have lived them.</p>
        </a>
        <a class="card" href="/harbor-of-hope">
          <h3>Harbor of Hope</h3>
          <p>If any of this is closer to home than you would like, here is where the real help is.</p>
        </a>
      </div>
    </div>
  </section>
</Base>

<style>
  .head { padding-block: clamp(46px, 7vw, 86px) clamp(20px, 3vw, 40px); }
  .book-grid {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: clamp(30px, 5vw, 64px);
    align-items: start;
  }
  .byline {
    font-family: var(--f-display);
    font-style: italic;
    font-size: 20px;
    color: var(--gold-lit);
  }
  .actions { display: flex; gap: 12px; flex-wrap: wrap; margin-top: 8px; }

  .cover { display: flex; flex-direction: column; gap: 16px; }
  .pull {
    font-family: var(--f-display);
    font-size: 21px;
    line-height: 1.45;
    font-style: italic;
  }

  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 26px;
  }
  .card {
    display: flex;
    flex-direction: column;
    gap: 8px;
    text-decoration: none;
    color: inherit;
    padding-top: 20px;
    border-top: 2px solid var(--plum);
    transition: border-color .18s ease;
  }
  .card:hover { border-top-color: var(--gold); }
  .card:hover h3 { color: var(--gold-lit); }
  .card p { color: var(--pearl-dim); font-size: 16px; }

  @media (max-width: 820px) {
    .book-grid { grid-template-columns: 1fr; }
  }
</style>
