# Contact form (Web3Forms — free, no server, no account needed).
#
# To switch the form on:
#   1. Go to https://web3forms.com
#   2. Enter hbkgrandpavilion@gmail.com — they email an access key straight back
#   3. Paste the key below, and set the same variable in Vercel:
#      Project → Settings → Environment Variables → PUBLIC_CONTACT_FORM_KEY
#
# Until a key is set the contact page shows the email address and social
# routes only. It never renders a form that cannot deliver.
PUBLIC_CONTACT_FORM_KEY=
